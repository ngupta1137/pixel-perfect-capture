# ==============================================================================
# Verity Enterprise Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or configure in your deployment platform / Lovable secrets).
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# --- Supabase Project & API Configuration ---
# The HTTPS URL for your Supabase project instance (Settings > API)
SUPABASE_URL="https://your-project-id.supabase.co"

# The publishable Anonymous API key for client-safe operations (Settings > API)
SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"

# The privileged Service Role API key for secure server-side RPCs and storage admin
# WARNING: NEVER expose this key to browser bundles or client code.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# --- Supabase Authoritative PostgreSQL Connection ---
# The authoritative PostgreSQL connection string (Settings > Database > Connection Pooling).
# RECOMMENDED: Use Supabase Transaction Pooler (Port 6543) with sslmode=require
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# --- Supabase Storage Configuration ---
# Name of the dedicated Supabase Storage bucket for durable raw source files (PDF, Word, TXT)
SUPABASE_STORAGE_BUCKET="verity-source-documents"

# --- Authentication & Session Security ---
# High-entropy secret used for HMAC-SHA256 signing of server session tokens.
# Must be at least 32 characters long in production environments.
VERITY_SESSION_SECRET="your-verity-session-hmac-secret-min-32-chars-placeholder"
